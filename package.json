{
  "name": "@j-256/endpoint-monitor",
  "version": "0.2.1",
  "private": true,
  "description": "A self-deploying Cloudflare Worker service for explicit public endpoint monitoring",
  "license": "AGPL-3.0-only",
  "keywords": [
    "cloudflare-workers",
    "cloudevents",
    "d1",
    "endpoint-monitoring",
    "uptime-monitoring"
  ],
  "homepage": "https://github.com/j-256/endpoint-monitor#readme",
  "bugs": {
    "url": "https://github.com/j-256/endpoint-monitor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/j-256/endpoint-monitor.git"
  },
  "type": "module",
  "bin": {
    "endpoint-monitor": "src/cli.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "CHANGELOG.md",
    "docs/architecture.md",
    "docs/cloudflare.md",
    "docs/management.md",
    "docs/releases.md",
    "endpoint-monitor.example.json",
    "migrations/",
    "scripts/configure-cloudflare.mjs",
    "src/",
    "wrangler.example.jsonc"
  ],
  "scripts": {
    "capture:cover": "node scripts/capture-cover.mjs",
    "check": "npm test && npm run test:coverage && npm run check:publication && npm run check:cover && npm run release:check && npm run deploy:dry-run",
    "check:cover": "node scripts/capture-cover.mjs --check",
    "check:publication": "node scripts/check-publication.mjs",
    "db:migrate:local": "wrangler d1 migrations apply endpoint-monitor --local",
    "db:migrate:remote": "wrangler d1 migrations apply endpoint-monitor --remote",
    "deploy": "node src/cli.mjs deploy",
    "deploy:dry-run": "wrangler deploy --dry-run --config wrangler.example.jsonc",
    "dev": "wrangler dev",
    "release:build": "npm run check && node scripts/release.mjs build",
    "release:check": "node scripts/release.mjs check",
    "test": "node --test test/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude=test/** --test-coverage-exclude=scripts/capture-cover.mjs --test-coverage-exclude=scripts/release.mjs --test-coverage-branches=85 --test-coverage-functions=90 --test-coverage-lines=90 test/*.test.mjs"
  },
  "dependencies": {
    "wrangler": "4.127.1"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
